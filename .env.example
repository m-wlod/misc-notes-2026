# Copy to .env.local and fill in. Every variable is validated in src/env.schema.ts.
# Blank values are treated as unset. Later phases make their variables required.

# --- App ---
# Optional: falls back to Vercel's production/deployment URL, then localhost.
NEXT_PUBLIC_SITE_URL=
# "1" shows /styleguide on a non-Vercel production build. Ignored on Vercel production.
ENABLE_STYLEGUIDE=

# --- Supabase (Phase 3). Local values are printed by `pnpm db:start`. ---
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# --- AI grading (Phase 10) ---
ANTHROPIC_API_KEY=
AI_GRADER_MODEL=
AI_DAILY_BUDGET_USD=5
AI_USER_DAILY_QUOTA=10

# --- Rate limiting (Phase 8/10) ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Email (Resend; needs a verified domain) ---
RESEND_API_KEY=
EMAIL_FROM=

# --- Web push (Phase 15). Generate with `pnpm dlx web-push generate-vapid-keys`. ---
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# --- Cron auth (Phase 14) ---
CRON_SECRET=

# --- Analytics / errors (Phase 22, consent-gated) ---
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=

# --- Bot protection (Phase 21) ---
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
